{
  "name": "rackofci-energy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kedy zap\u00edna\u0165 spotrebi\u010de: \u017eiv\u00fd v\u00fdkon fotovoltiky, predpove\u010f v\u00fdroby a odpor\u00fa\u010dania pod\u013ea tarify VT/NT.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "TZ=Europe/Bratislava node --test --experimental-test-coverage --test-coverage-include='shared/**' --test-coverage-include='web/state.js' --test-coverage-lines=90 test/*.test.js worker/test/*.test.js",
    "test:e2e": "playwright test",
    "fixtures": "node test/fixtures/generate.js",
    "screenshots": "node test/screenshots/generate.js",
    "serve": "http-server -p 8080 -c-1 .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "http-server": "14.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
